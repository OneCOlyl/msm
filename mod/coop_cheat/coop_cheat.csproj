<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>coop_cheat</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.7</Version>
    <Libs Condition="'$(Libs)' == ''">$(MSBuildThisFileDirectory)../../libs</Libs>
    <Stubs>$(MSBuildThisFileDirectory)../../stubs/out</Stubs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ModKit"><HintPath>$(Libs)/ModKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="modkit_spells"><HintPath>$(Libs)/modkit_spells.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="modkit_effects"><HintPath>$(Libs)/modkit_effects.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="modkit_data"><HintPath>$(Libs)/modkit_data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="modkit_spells_data"><HintPath>$(Libs)/modkit_spells_data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Stubs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Stubs)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
