<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>coop_probe</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Libs Condition="'$(Libs)' == ''">$(MSBuildThisFileDirectory)../../libs</Libs>
    <Stubs>$(MSBuildThisFileDirectory)../../stubs/out</Stubs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ModKit"><HintPath>$(Libs)/ModKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="modkit_combat"><HintPath>$(Libs)/modkit_combat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Stubs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
